# Cloudinary (public — safe in the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ptp8diwd
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=portfolio_upload

# Cloudinary (server-only — signed uploads). Never commit real values.
CLOUDINARY_CLOUD_NAME=ptp8diwd
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allow signed uploads outside development (e.g. production edit mode)
# ALLOW_CLOUDINARY_UPLOAD=true
# NEXT_PUBLIC_ALLOW_EDIT=true
