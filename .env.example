# ── Vercel Blob (new uploads) ─────────────────────────────────────────────
# Create a store: Vercel Dashboard → Storage → Blob → Create
# Then: store → .env.local tab / Tokens → generate BLOB_READ_WRITE_TOKEN
# Or CLI: vercel env pull
BLOB_READ_WRITE_TOKEN=

# Allow Blob uploads outside development (production edit mode)
# ALLOW_BLOB_UPLOAD=true
# NEXT_PUBLIC_ALLOW_EDIT=true

# ── Optional / legacy ─────────────────────────────────────────────────────
# Existing Cloudinary URLs in defaults continue to work without these vars.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
